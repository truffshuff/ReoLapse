# Copy to .env and fill in. .env is git-ignored.
REOLINK_HOST=192.168.1.x
REOLINK_USER=admin
REOLINK_PASSWORD=
# Optional: HTTP port if not 80
REOLINK_PORT=80
# Optional: share for raw footage + finished outputs (default /Volumes/Photos/ReoLink)
# REOLAPSE_DATA=/Volumes/Photos/ReoLink
# Optional: local working area for backgrounds/object data/rendering (much faster than the share).
# Outputs are copied to the share when rendering finishes. Not under ~/Documents (iCloud).
# REOLAPSE_WORK=~/Library/Caches/reolapse
